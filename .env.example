# Copy to .env and adjust. All keys are prefixed with FA_.
FA_QDRANT_URL=http://localhost:6333
FA_YOLO_IMGSZ=960
FA_YOLO_CONF=0.4
FA_MATCH_THRESHOLD=0.5
FA_COOLDOWN_SECONDS=60
FA_VOTE_FRAMES=3
FA_CAMERA_ID=cam-0
# Optional IP camera, pre-filled in the attendance tab
FA_RTSP_URL=
# NAFNet restoration of dark / blurry faces (set false to disable)
FA_ENHANCE_ENABLED=true
FA_ENHANCE_DARK_LUMA=70
FA_ENHANCE_BLUR_SHARPNESS=60
